{
    "name": "formsvox/formsvox",
    "description": "FormsVox - High performance, accessible WordPress Form Builder plugin.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "FormsVox Team",
            "email": "support@formsvox.io"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "wp-coding-standards/wpcs": "^3.0",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "FormsVox\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FormsVox\\Tests\\": "tests/phpunit/"
        }
    },
    "scripts": {
        "phpcs": "vendor/bin/phpcs --standard=phpcs.xml.dist",
        "phpcbf": "vendor/bin/phpcbf --standard=phpcs.xml.dist",
        "phpstan": "vendor/bin/phpstan analyse -c phpstan.neon",
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
